    <bpmn:sequenceFlow id="Flow_0pigeo9" sourceRef="PrintPosterRequestDecision" targetRef="Gateway_1r4ovy0" />
    <bpmn:serviceTask id="ConfirmPosterRequest" name="Confirm Poster Request">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="deployment://templates/posterRequestConfirmationEnvelope.ftl" />
            </camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8888/postingservice</camunda:inputParameter>
            <camunda:outputParameter name="orderInformation">${billParserService.unmarshallBill(XML(response).childElement("Body").childElement("http://disim.univaq.it/services/postingservice", "confirmationResponse").childElement("bill"))}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>soap-http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1th31ty</bpmn:incoming>
      <bpmn:outgoing>Flow_05kpviq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="ConfirmPosterRequestBranch" name="Confirm Poster Request Branch" sourceRef="Gateway_1r4ovy0" targetRef="PrintConfirmPosterRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">posterRequestDecision.decision == "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:scriptTask id="PrintConfirmPosterRequest" name="Print Confirm Poster Request" scriptFormat="javascript">
      <bpmn:incoming>ConfirmPosterRequestBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_1th31ty</bpmn:outgoing>
      <bpmn:script>java.lang.System.out.println("\nPoster Request Confirmed\n");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1th31ty" sourceRef="PrintConfirmPosterRequest" targetRef="ConfirmPosterRequest" />
    <bpmn:scriptTask id="PrintPosterRequestCancelled" name="Print Poster Request Cancelled" scriptFormat="javascript">
      <bpmn:incoming>CancelPosterRequestBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_0ehd2qe</bpmn:outgoing>
      <bpmn:script>java.lang.System.out.println("\nPoster Request Cancelled\n");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="CancelPosterRequestBranch" name="Cancel Poster Request Branch" sourceRef="Gateway_1r4ovy0" targetRef="PrintPosterRequestCancelled">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">posterRequestDecision.decision == "cancel"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
