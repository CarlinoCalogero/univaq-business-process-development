    <bpmn:serviceTask id="CancelPosterRequest" name="Cancel Poster Request">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="deployment://templates/posterRequestCancelEnvelope.ftl" />
            </camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8888/postingservice</camunda:inputParameter>
            <camunda:outputParameter name="cancelInformation">${response}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>soap-http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>CancelPosterRequestBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_0ibzzwr</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0ibzzwr" sourceRef="CancelPosterRequest" targetRef="SendRequestCancelNotification" />
    <bpmn:serviceTask id="SendRequestCancelNotification" name="Send Request Cancel Notification" camunda:delegateExpression="${requestCancelNotifierDelegate}">
      <bpmn:incoming>Flow_0ibzzwr</bpmn:incoming>
      <bpmn:outgoing>Flow_02245by</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_02245by" sourceRef="SendRequestCancelNotification" targetRef="Gateway_0j4a4m4" />
  </bpmn:process>
