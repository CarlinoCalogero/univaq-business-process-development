    <bpmn:serviceTask id="CheckAvailability" name="Check Availability">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="deployment://templates/availabilityRequestEnvelope.ftl" />
            </camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8888/postingservice</camunda:inputParameter>
            <camunda:outputParameter name="checkAvailabilityResponse">${checkAvailabilityResponseParserService.unmarshallCheckAvailabilityResponse(XML(response).childElement("Body").childElement("http://disim.univaq.it/services/postingservice", "availabilityResponse"))}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>soap-http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19cnuiz</bpmn:incoming>
