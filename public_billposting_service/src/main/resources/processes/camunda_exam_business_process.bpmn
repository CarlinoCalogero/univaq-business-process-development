<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_0j198xd" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.23.0">
  <bpmn:process id="PublicBillpostingService" name="Public Billposting Service" isExecutable="true" camunda:historyTimeToLive="1">
    <bpmn:endEvent id="Event_1fbyf7h">
      <bpmn:incoming>Flow_16lqhso</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="GetUserData" name="Get User Data">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:9080/user/${posterAvailabilityRequest.username}</camunda:inputParameter>
            <camunda:outputParameter name="userData">${userParserService.unmarshallUser(response)}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0bqszhx</bpmn:incoming>
      <bpmn:outgoing>Flow_0u5u962</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0u5u962" sourceRef="GetUserData" targetRef="Gateway_00w3col" />
    <bpmn:parallelGateway id="Gateway_1xgojrv">
      <bpmn:incoming>Flow_1n3q7b4</bpmn:incoming>
      <bpmn:outgoing>Flow_0bqszhx</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rgd867</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_0bqszhx" sourceRef="Gateway_1xgojrv" targetRef="GetUserData" />
    <bpmn:serviceTask id="GetZoneData" name="Get Zone Data">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">GET</camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:9090/zones/${posterAvailabilityRequest.posterFormat}</camunda:inputParameter>
            <camunda:outputParameter name="zoneData">${zoneParserService.unmarshallZoneList(JSON(response))}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rgd867</bpmn:incoming>
      <bpmn:outgoing>Flow_0vxx5i8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0vxx5i8" sourceRef="GetZoneData" targetRef="Gateway_00w3col" />
    <bpmn:sequenceFlow id="Flow_0rgd867" sourceRef="Gateway_1xgojrv" targetRef="GetZoneData" />
    <bpmn:parallelGateway id="Gateway_00w3col">
      <bpmn:incoming>Flow_0vxx5i8</bpmn:incoming>
      <bpmn:incoming>Flow_0u5u962</bpmn:incoming>
      <bpmn:outgoing>Flow_0ca8rbn</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="SelectZones" name="Select Zones" camunda:delegateExpression="${zoneSelectorDelegate}">
      <bpmn:incoming>Flow_0ca8rbn</bpmn:incoming>
      <bpmn:outgoing>Flow_00xadoe</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0ca8rbn" sourceRef="Gateway_00w3col" targetRef="SelectZones" />
    <bpmn:sequenceFlow id="Flow_00xadoe" sourceRef="SelectZones" targetRef="CheckAvailability" />
    <bpmn:serviceTask id="CheckAvailability" name="Check Availability">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="deployment://templates/availabilityRequestEnvelope.ftl" />
            </camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8888/postingservice</camunda:inputParameter>
            <camunda:outputParameter name="checkAvailabilityResponse">${checkAvailabilityResponseParserService.unmarshallCheckAvailabilityResponse(XML(response).childElement("Body").childElement("http://disim.univaq.it/services/postingservice", "availabilityResponse"))}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>soap-http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_00xadoe</bpmn:incoming>
      <bpmn:outgoing>Flow_0y740my</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0y740my" sourceRef="CheckAvailability" targetRef="PosterRequestDecision" />
    <bpmn:intermediateCatchEvent id="PosterRequestDecision" name="Poster Request Decision">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="correlationVariable">${checkAvailabilityResponse.requestId}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y740my</bpmn:incoming>
      <bpmn:outgoing>Flow_17q3kc4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_04a5ro6" messageRef="Message_3fbi84q" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_17q3kc4" sourceRef="PosterRequestDecision" targetRef="Gateway_1r4ovy0" />
    <bpmn:exclusiveGateway id="Gateway_1r4ovy0">
      <bpmn:incoming>Flow_17q3kc4</bpmn:incoming>
      <bpmn:outgoing>ConfirmPosterRequestBranch</bpmn:outgoing>
      <bpmn:outgoing>CancelPosterRequestBranch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ConfirmPosterRequest" name="Confirm Poster Request">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="freemarker" resource="deployment://templates/posterRequestConfirmationEnvelope.ftl" />
            </camunda:inputParameter>
            <camunda:inputParameter name="url">http://localhost:8888/postingservice</camunda:inputParameter>
            <camunda:outputParameter name="orderInformation">${billParserService.unmarshallBill(XML(response).childElement("Body").childElement("http://disim.univaq.it/services/postingservice", "confirmationResponse").childElement("bill"))}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>soap-http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>ConfirmPosterRequestBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_05kpviq</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="ConfirmPosterRequestBranch" name="Confirm Poster Request Branch" sourceRef="Gateway_1r4ovy0" targetRef="ConfirmPosterRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">posterRequestDecision.decision == "confirm"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CancelPosterRequestBranch" name="Cancel Poster Request Branch" sourceRef="Gateway_1r4ovy0" targetRef="CancelPosterRequest">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" language="javascript">posterRequestDecision.decision == "cancel"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0j4a4m4">
      <bpmn:incoming>Flow_07y5flo</bpmn:incoming>
      <bpmn:incoming>Flow_02245by</bpmn:incoming>
      <bpmn:outgoing>Flow_16lqhso</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_16lqhso" sourceRef="Gateway_0j4a4m4" targetRef="Event_1fbyf7h" />
    <bpmn:sequenceFlow id="Flow_05kpviq" sourceRef="ConfirmPosterRequest" targetRef="WriteRequestInformationFile" />
    <bpmn:serviceTask id="WriteRequestInformationFile" name="Write Request Information File" camunda:delegateExpression="${requestFileWriterDelegate}">
      <bpmn:incoming>Flow_05kpviq</bpmn:incoming>
      <bpmn:outgoing>Flow_07y5flo</bpmn:outgoing>
    </bpmn:serviceTask>
